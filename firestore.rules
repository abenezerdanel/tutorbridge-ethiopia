        );
      allow update: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidMessagingRestriction(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            (
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['appealText', 'appealStatus', 'updatedAt']) &&
                incoming().appealStatus == 'pending'
              ) ||
              (
                incoming().violationCount > existing().violationCount &&
                incoming().status == 'active' &&
                incoming().restrictionLevel in ['warning', 'temp_restricted', 'suspended_review'] &&
                incoming().appealStatus == existing().appealStatus
              )
            )
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /moderation_actions/{actionId} {
      allow get: if isValidId(actionId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(actionId) &&
        isAdmin() &&
        isValidModerationAction(incoming()) &&
        incoming().adminUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /platform_moderation_settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isValidId(settingId) &&
        isAdmin() &&
        isValidPlatformModerationSetting(incoming());
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) &&
        isVerifiedUser() &&
        isValidAuditLog(incoming()) &&
        incoming().createdAt == request.time &&
        (
          isAdmin() ||
          incoming().actorUid == request.auth.uid
        );
      allow update, delete: if false;
    }
  }
}
