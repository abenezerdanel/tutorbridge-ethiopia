        data.appealStatus in ['none', 'pending', 'approved', 'rejected'] &&
        (!('appealText' in data) || isStr(data.appealText, 0, 1000)) &&
        (!('adminDecisionNotes' in data) || isStr(data.adminDecisionNotes, 0, 600)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidModerationAction(data) {
      return data.keys().hasAll(['adminUid', 'targetUserId', 'actionType', 'notes', 'createdAt']) &&
        data.keys().hasOnly(['adminUid', 'targetUserId', 'conversationId', 'flagId', 'actionType', 'notes', 'createdAt']) &&
        isValidId(data.adminUid) &&
        isValidId(data.targetUserId) &&
        (!('conversationId' in data) || isStr(data.conversationId, 0, 128)) &&
        (!('flagId' in data) || isStr(data.flagId, 0, 128)) &&
        data.actionType in ['issue_warning', 'restrict_messaging', 'lift_restriction', 'suspend_account', 'approve_exception', 'dismiss_flag', 'resolve_appeal', 'update_settings'] &&
        isStr(data.notes, 2, 600) &&
        data.createdAt is timestamp;
    }

    function isValidPlatformModerationSetting(data) {
      return data.keys().hasAll([
          'key', 'blockPhoneNumbers', 'blockWhatsApp', 'blockEmails', 'blockUrls',
          'blockSocialMedia', 'blockMeetingLinks', 'detectSplitMessages', 'scanAttachments',
          'warningThreshold', 'tempRestrictionThreshold', 'suspensionReviewThreshold',
          'tempRestrictionHours', 'approvedExceptions', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'key', 'blockPhoneNumbers', 'blockWhatsApp', 'blockEmails', 'blockUrls',
          'blockSocialMedia', 'blockMeetingLinks', 'detectSplitMessages', 'scanAttachments',
          'warningThreshold', 'tempRestrictionThreshold', 'suspensionReviewThreshold',
          'tempRestrictionHours', 'approvedExceptions', 'updatedAt'
        ]) &&
        isStr(data.key, 2, 80) &&
        data.blockPhoneNumbers is bool &&
        data.blockWhatsApp is bool &&
        data.blockEmails is bool &&
        data.blockUrls is bool &&
        data.blockSocialMedia is bool &&
        data.blockMeetingLinks is bool &&
        data.detectSplitMessages is bool &&
        data.scanAttachments is bool &&
        data.warningThreshold is number && data.warningThreshold >= 1 && data.warningThreshold <= 10 &&
        data.tempRestrictionThreshold is number && data.tempRestrictionThreshold >= 1 && data.tempRestrictionThreshold <= 20 &&
        data.suspensionReviewThreshold is number && data.suspensionReviewThreshold >= 2 && data.suspensionReviewThreshold <= 50 &&
        data.tempRestrictionHours is number && data.tempRestrictionHours >= 1 && data.tempRestrictionHours <= 720 &&
        isBoundedStrList(data.approvedExceptions, 0, 100) &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorRole', 'eventType', 'summary', 'createdAt']) &&
        data.keys().hasOnly(['actorUid', 'actorRole', 'eventType', 'conversationId', 'targetId', 'summary', 'createdAt']) &&
        isValidId(data.actorUid) &&
        isStr(data.actorRole, 2, 40) &&
        isStr(data.eventType, 2, 100) &&
        (!('conversationId' in data) || isStr(data.conversationId, 0, 128)) &&
        (!('targetId' in data) || isStr(data.targetId, 0, 128)) &&
        isStr(data.summary, 2, 500) &&
        data.createdAt is timestamp;
    }

    // =========================================================================
    // COLLECTION MATCH RULES
    // =========================================================================

    match /test/connection {
      allow get: if true;
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update: if isValidId(categoryId) &&
        isAdmin() &&
        isValidCategory(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidUserAccount(incoming()) &&
        request.auth.uid == userId &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().status == 'active' &&
        (
          incoming().role in ['parent', 'tutor', 'trainer', 'organization'] ||
          (incoming().role == 'admin' && isAdmin())
        );
      allow update: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidUserAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'city', 'subCity', 'languagePreference', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminId) &&
        isAdmin() &&
        isValidAdminRecord(incoming());
      allow delete: if isValidId(adminId) && isAdmin() && adminId != request.auth.uid;
    }

    match /tutors/{tutorId} {
      allow get: if isValidId(tutorId) && (
        existing().status == 'approved' ||
        (isSignedIn() && existing().userId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if resource.data.status == 'approved' ||
        (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if isValidId(tutorId) &&
        isVerifiedUser() &&
        isValidTutorProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            incoming().userId == request.auth.uid &&
            incoming().status == 'pending' &&
            incoming().isVerified == false &&
            incoming().ratingAvg == 0 &&
            incoming().reviewCount == 0 &&
            !containsProhibitedContact(incoming().headline) &&
            !containsProhibitedContact(incoming().bio) &&
            !containsProhibitedContact(incoming().qualifications)
          )
        );
      allow update: if isValidId(tutorId) &&
        isVerifiedUser() &&
        isValidTutorProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().status == existing().status &&
            incoming().isVerified == existing().isVerified &&
            incoming().ratingAvg == existing().ratingAvg &&
            incoming().reviewCount == existing().reviewCount &&
            !containsProhibitedContact(incoming().headline) &&
            !containsProhibitedContact(incoming().bio) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'headline', 'bio', 'photoUrl', 'hourlyRateEtb',
              'availabilityDays', 'subCities', 'languages', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(tutorId) && isAdmin();
    }

    match /tutor_documents/{docId} {
      allow get: if isValidId(docId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(docId) &&
        isVerifiedUser() &&
        isValidTutorDocument(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          exists(/databases/$(database)/documents/tutors/$(incoming().tutorId)) ||
          exists(/databases/$(database)/documents/corporate_trainers/$(incoming().tutorId))
        );
      allow update: if isValidId(docId) &&
        isAdmin() &&
        isValidTutorDocument(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().tutorId == existing().tutorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /students/{studentId} {
      allow get: if isValidId(studentId) && isSignedIn() && (existing().parentId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.parentId == request.auth.uid || isAdmin());
      allow create: if isValidId(studentId) &&
        isVerifiedUser() &&
        isValidStudentProfile(incoming()) &&
        incoming().parentId == request.auth.uid &&
        incoming().parentConsent == true &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(studentId) &&
        isVerifiedUser() &&
        isValidStudentProfile(incoming()) &&
        incoming().parentId == existing().parentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().parentId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'age', 'gradeLevel', 'schoolName',
              'subjectsNeeded', 'learningGoals', 'preferredSchedule', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(studentId) && isSignedIn() && (existing().parentId == request.auth.uid || isAdmin());
    }

    match /tutor_requests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (existing().parentId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.parentId == request.auth.uid || isAdmin());
      allow create: if isValidId(requestId) &&
        isVerifiedUser() &&
        isValidTutorRequest(incoming()) &&
        incoming().parentId == request.auth.uid &&
        incoming().status == 'pending_review' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(requestId) &&
        isVerifiedUser() &&
        isValidTutorRequest(incoming()) &&
        incoming().parentId == existing().parentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().parentId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            (
              (existing().status == 'candidates_proposed' && incoming().status == 'matched') ||
              (existing().status in ['pending_review', 'candidates_proposed'] && incoming().status == 'cancelled')
            )
          )
        );
      allow delete: if isValidId(requestId) && isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (
        existing().parentId == request.auth.uid ||
        existing().tutorUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.tutorUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(bookingId) &&
        isVerifiedUser() &&
        isValidBooking(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/tutors/$(incoming().tutorId)) &&
        (
          isAdmin() ||
          (
            incoming().parentId == request.auth.uid &&
            incoming().status == 'pending_tutor' &&
            incoming().paymentStatus == 'unpaid'
          )
        );
      allow update: if isValidId(bookingId) &&
        isVerifiedUser() &&
        isValidBooking(incoming()) &&
        incoming().parentId == existing().parentId &&
        incoming().tutorId == existing().tutorId &&
        incoming().tutorUserId == existing().tutorUserId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().status != 'completed' &&
            existing().status != 'cancelled' &&
            (
              (
                existing().tutorUserId == request.auth.uid &&
                incoming().paymentStatus == existing().paymentStatus &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                (
                  (existing().status == 'pending_tutor' && incoming().status in ['pending_payment', 'cancelled']) ||
                  (existing().status == 'confirmed' && incoming().status == 'completed')
                )
              ) ||
              (
                existing().parentId == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt']) &&
                (
                  (existing().status in ['pending_tutor', 'pending_payment'] && incoming().status == 'cancelled' && incoming().paymentStatus == existing().paymentStatus) ||
                  (existing().status == 'pending_payment' && existing().paymentStatus == 'unpaid' && incoming().paymentStatus == 'submitted' && incoming().status == existing().status)
                )
              )
            )
          )
        );
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (
        existing().parentId == request.auth.uid ||
        existing().tutorUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.tutorUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(paymentId) &&
        isVerifiedUser() &&
        isValidPaymentRecord(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
        (
          isAdmin() ||
          (
            incoming().parentId == request.auth.uid &&
            incoming().status == 'pending_verification'
          )
        );
      allow update: if isValidId(paymentId) &&
        isAdmin() &&
        isValidPaymentRecord(incoming()) &&
        incoming().bookingId == existing().bookingId &&
        incoming().parentId == existing().parentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(paymentId) && isAdmin();
    }

    match /progress_reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (
        existing().parentId == request.auth.uid ||
        existing().tutorUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.tutorUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(reportId) &&
        isVerifiedUser() &&
        isValidProgressReport(incoming()) &&
        incoming().tutorUserId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/bookings/$(incoming().bookingId));
      allow update: if isValidId(reportId) &&
        isVerifiedUser() &&
        isValidProgressReport(incoming()) &&
        incoming().bookingId == existing().bookingId &&
        incoming().parentId == existing().parentId &&
        incoming().tutorUserId == existing().tutorUserId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().parentId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['parentComment', 'updatedAt'])
          )
        );
      allow delete: if isValidId(reportId) && isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId) &&
        isVerifiedUser() &&
        isValidReview(incoming()) &&
        incoming().parentId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/bookings/$(incoming().bookingId));
      allow update, delete: if isValidId(reviewId) && isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(ticketId) &&
        isVerifiedUser() &&
        isValidSupportTicket(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(ticketId) &&
        isAdmin() &&
        isValidSupportTicket(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(ticketId) && isAdmin();
    }

    match /admin_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) &&
        isAdmin() &&
        isValidAdminLog(incoming()) &&
        incoming().adminUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /platform_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isValidId(settingId) && isAdmin() && isValidPlatformSetting(incoming());
    }

    // =========================================================================
    // V1.1 CORPORATE & ORGANIZATIONAL TRAINING MATCH RULES
    // =========================================================================

    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(orgId) &&
        isVerifiedUser() &&
        isValidOrganization(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            incoming().ownerUid == request.auth.uid &&
            incoming().status == 'pending'
          )
        );
      allow update: if isValidId(orgId) &&
        isVerifiedUser() &&
        isValidOrganization(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'orgType', 'industry', 'contactPerson', 'officialEmail',
              'phone', 'address', 'logoUrl', 'billingInfo', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(orgId) && isAdmin();
    }

    match /organization_users/{orgUserId} {
      allow get: if isValidId(orgUserId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(orgUserId) &&
        isVerifiedUser() &&
        isValidOrganizationUser(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/organizations/$(incoming().organizationId)) &&
        (
          isAdmin() ||
          (
            incoming().userId == request.auth.uid &&
            incoming().role == 'owner' &&
            get(/databases/$(database)/documents/organizations/$(incoming().organizationId)).data.ownerUid == request.auth.uid
          )
        );
      allow update, delete: if isValidId(orgUserId) && isAdmin();
    }

    match /corporate_requests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(requestId) &&
        isVerifiedUser() &&
        isValidCorporateRequest(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().status == 'pending_review' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/organizations/$(incoming().organizationId));
      allow update: if isValidId(requestId) &&
        isVerifiedUser() &&
        isValidCorporateRequest(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            existing().status == 'proposal_sent' &&
            incoming().status in ['approved', 'rejected'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(requestId) && isAdmin();
    }

    match /corporate_trainers/{trainerId} {
      allow get: if isValidId(trainerId) && isSignedIn() && (
        existing().status == 'approved' ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.status == 'approved' ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(trainerId) &&
        isVerifiedUser() &&
        isValidCorporateTrainer(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            incoming().userId == request.auth.uid &&
            incoming().status == 'pending' &&
            incoming().isVerified == false &&
            (!('ratingAvg' in incoming()) || incoming().ratingAvg == 0) &&
            (!('reviewCount' in incoming()) || incoming().reviewCount == 0) &&
            !containsProhibitedContact(incoming().headline) &&
            !containsProhibitedContact(incoming().qualifications) &&
            !containsProhibitedContact(incoming().methodology) &&
            (!('bio' in incoming()) || !containsProhibitedContact(incoming().bio)) &&
            (!('workExperience' in incoming()) || !containsProhibitedContact(incoming().workExperience))
          )
        );
      allow update: if isValidId(trainerId) &&
        isVerifiedUser() &&
        isValidCorporateTrainer(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().status == existing().status &&
            incoming().isVerified == existing().isVerified &&
            incoming().qualifications == existing().qualifications &&
            !containsProhibitedContact(incoming().headline) &&
            !containsProhibitedContact(incoming().methodology) &&
            (!('bio' in incoming()) || !containsProhibitedContact(incoming().bio)) &&
            (!('workExperience' in incoming()) || !containsProhibitedContact(incoming().workExperience)) &&
            (!('pendingQualificationUpdate' in incoming()) || !containsProhibitedContact(incoming().pendingQualificationUpdate)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'headline', 'bio', 'photoUrl', 'workExperience', 'pastProjects',
              'methodology', 'availability', 'preferredLocations', 'languages',
              'proposedDailyRateEtb', 'pendingQualificationUpdate', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(trainerId) && isAdmin();
    }

    match /trainer_portfolio_items/{itemId} {
      allow get: if isValidId(itemId) && isSignedIn() && (
        existing().status == 'approved' ||
        existing().trainerUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.status == 'approved' ||
        resource.data.trainerUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(itemId) &&
        isVerifiedUser() &&
        isValidTrainerPortfolioItem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/corporate_trainers/$(incoming().trainerId)) &&
        (
          isAdmin() ||
          (
            incoming().trainerUserId == request.auth.uid &&
            incoming().status == 'pending' &&
            !containsProhibitedContact(incoming().title) &&
            !containsProhibitedContact(incoming().summary) &&
            (!('outcomeMetrics' in incoming()) || !containsProhibitedContact(incoming().outcomeMetrics))
          )
        );
      allow update: if isValidId(itemId) &&
        isAdmin() &&
        isValidTrainerPortfolioItem(incoming()) &&
        incoming().trainerId == existing().trainerId &&
        incoming().trainerUserId == existing().trainerUserId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(itemId) && isSignedIn() && (
        existing().trainerUserId == request.auth.uid || isAdmin()
      );
    }

    match /saved_trainers/{savedId} {
      allow get: if isValidId(savedId) && isSignedIn() && (
        existing().organizationOwnerUid == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.organizationOwnerUid == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(savedId) &&
        isVerifiedUser() &&
        isValidSavedTrainer(incoming()) &&
        incoming().organizationOwnerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
