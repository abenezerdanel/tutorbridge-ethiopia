rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL PRIMITIVES
    // =========================================================================

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'abenezerdaniel69@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isBoundedStrList(arr, minItems, maxItems) {
      return arr is list &&
        arr.size() >= minItems &&
        arr.size() <= maxItems &&
        (arr.size() == 0 || isStr(arr[0], 1, 120));
    }

    // Contact-protection RE2 defense-in-depth guard (no lookarounds supported in RE2)
    function containsProhibitedContact(txt) {
      return txt is string && (
        // Ethiopian phone formats (+251 / 00251 / 09 / 07 with separators)
        txt.matches('(?is).*(\\+?251|00251|09|07)[\\s.\\-()]*[0-9]{2}[\\s.\\-()]*[0-9]{2}[\\s.\\-()]*[0-9]{2}[\\s.\\-()]*[0-9]{2}.*') ||
        // International phone numbers starting with +
        txt.matches('(?is).*\\+[1-9][0-9\\s.\\-()]{7,15}.*') ||
        // Direct email addresses
        txt.matches('(?is).*[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}.*') ||
        // External messaging, meeting, and social media domains
        txt.matches('(?is).*(wa\\.me/|t\\.me/|telegram\\.me/|chat\\.whatsapp\\.com|zoom\\.us/|meet\\.google\\.com|teams\\.microsoft\\.com|facebook\\.com|fb\\.com|instagram\\.com|tiktok\\.com|linkedin\\.com|twitter\\.com|x\\.com/|discord\\.gg).*') ||
        // Generic external URLs while allowing official tutorbridge.et links
        (
          txt.matches('(?is).*(https?://|www\\.).*') &&
          (
            !txt.matches('(?is).*tutorbridge\\.et.*') ||
            txt.matches('(?is).*\\.(com|net|org|io|me|us|ly|gg|co|biz|info)(/|\\s|$).*')
          )
        )
      );
    }

    function isNotRestrictedFromMessaging() {
      return !exists(/databases/$(database)/documents/messaging_restrictions/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/messaging_restrictions/$(request.auth.uid)).data.status != 'active' ||
        get(/databases/$(database)/documents/messaging_restrictions/$(request.auth.uid)).data.restrictionLevel in ['none', 'warning'];
    }

    // =========================================================================
    // ENTITY VALIDATION BLUEPRINTS
    // =========================================================================

    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'role', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'fullName', 'role', 'phone', 'city', 'subCity', 'languagePreference', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        isStr(data.email, 3, 200) &&
        isStr(data.fullName, 2, 120) &&
        data.role in ['parent', 'tutor', 'trainer', 'organization', 'admin'] &&
        data.status in ['active', 'suspended'] &&
        (!('phone' in data) || isStr(data.phone, 0, 40)) &&
        (!('city' in data) || isStr(data.city, 0, 80)) &&
        (!('subCity' in data) || isStr(data.subCity, 0, 80)) &&
        (!('languagePreference' in data) || data.languagePreference in ['en', 'am']) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedAt']) &&
        isValidId(data.uid) &&
        isStr(data.email, 3, 200) &&
        data.grantedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['division', 'name', 'topics', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['division', 'name', 'topics', 'isActive', 'createdAt', 'updatedAt']) &&
        isStr(data.division, 2, 100) &&
        isStr(data.name, 2, 120) &&
        isBoundedStrList(data.topics, 1, 30) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTutorProfile(data) {
      return data.keys().hasAll([
          'userId', 'fullName', 'headline', 'bio', 'qualifications', 'experienceYears',
          'division', 'subjects', 'grades', 'city', 'subCities', 'hourlyRateEtb',
          'availabilityDays', 'languages', 'ratingAvg', 'reviewCount', 'status',
          'isVerified', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'fullName', 'headline', 'bio', 'photoUrl', 'qualifications', 'experienceYears',
          'division', 'subjects', 'grades', 'city', 'subCities', 'hourlyRateEtb',
          'availabilityDays', 'languages', 'ratingAvg', 'reviewCount', 'status',
          'isVerified', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        isStr(data.fullName, 2, 120) &&
        isStr(data.headline, 4, 160) &&
        isStr(data.bio, 10, 2000) &&
        (!('photoUrl' in data) || isStr(data.photoUrl, 0, 500)) &&
        isStr(data.qualifications, 2, 300) &&
        data.experienceYears is number && data.experienceYears >= 0 && data.experienceYears <= 60 &&
        data.division in ['Academic Tutoring', 'Languages & Personal Development', 'Professional & Practical Skills'] &&
        isBoundedStrList(data.subjects, 1, 15) &&
        isBoundedStrList(data.grades, 1, 15) &&
        isStr(data.city, 2, 80) &&
        isBoundedStrList(data.subCities, 1, 15) &&
        data.hourlyRateEtb is number && data.hourlyRateEtb >= 100 && data.hourlyRateEtb <= 25000 &&
        isBoundedStrList(data.availabilityDays, 1, 7) &&
        isBoundedStrList(data.languages, 1, 8) &&
        data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5 &&
        data.reviewCount is number && data.reviewCount >= 0 &&
        data.status in ['pending', 'approved', 'rejected', 'suspended'] &&
        data.isVerified is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTutorDocument(data) {
      return data.keys().hasAll(['tutorId', 'userId', 'docType', 'title', 'referenceCode', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['tutorId', 'userId', 'docType', 'title', 'referenceCode', 'notes', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.tutorId) &&
        isValidId(data.userId) &&
        data.docType in ['national_id', 'degree_certificate', 'teaching_license', 'reference_letter'] &&
        isStr(data.title, 2, 160) &&
        isStr(data.referenceCode, 2, 120) &&
        (!('notes' in data) || isStr(data.notes, 0, 500)) &&
        data.status in ['pending', 'verified', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudentProfile(data) {
      return data.keys().hasAll(['parentId', 'fullName', 'age', 'gradeLevel', 'subjectsNeeded', 'parentConsent', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['parentId', 'fullName', 'age', 'gradeLevel', 'schoolName', 'subjectsNeeded', 'learningGoals', 'preferredSchedule', 'parentConsent', 'createdAt', 'updatedAt']) &&
        isValidId(data.parentId) &&
        isStr(data.fullName, 2, 120) &&
        data.age is number && data.age >= 3 && data.age <= 65 &&
        isStr(data.gradeLevel, 1, 80) &&
        (!('schoolName' in data) || isStr(data.schoolName, 0, 120)) &&
        isBoundedStrList(data.subjectsNeeded, 1, 15) &&
        (!('learningGoals' in data) || isStr(data.learningGoals, 0, 600)) &&
        (!('preferredSchedule' in data) || isStr(data.preferredSchedule, 0, 200)) &&
        data.parentConsent is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTutorRequest(data) {
      return data.keys().hasAll(['parentId', 'parentName', 'studentName', 'gradeLevel', 'division', 'subjects', 'city', 'subCity', 'preferredSchedule', 'budgetMaxEtb', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['parentId', 'parentName', 'studentName', 'gradeLevel', 'division', 'subjects', 'city', 'subCity', 'preferredSchedule', 'budgetMaxEtb', 'notes', 'status', 'proposedTutorId', 'proposedTutorName', 'adminNotes', 'createdAt', 'updatedAt']) &&
        isValidId(data.parentId) &&
        isStr(data.parentName, 2, 120) &&
        isStr(data.studentName, 2, 120) &&
        isStr(data.gradeLevel, 1, 80) &&
        data.division in ['Academic Tutoring', 'Languages & Personal Development', 'Professional & Practical Skills'] &&
        isBoundedStrList(data.subjects, 1, 10) &&
        isStr(data.city, 2, 80) &&
        isStr(data.subCity, 2, 80) &&
        isStr(data.preferredSchedule, 2, 200) &&
        data.budgetMaxEtb is number && data.budgetMaxEtb >= 100 && data.budgetMaxEtb <= 50000 &&
        (!('notes' in data) || isStr(data.notes, 0, 1000)) &&
        data.status in ['pending_review', 'candidates_proposed', 'matched', 'cancelled'] &&
        (!('proposedTutorId' in data) || isStr(data.proposedTutorId, 0, 128)) &&
        (!('proposedTutorName' in data) || isStr(data.proposedTutorName, 0, 120)) &&
        (!('adminNotes' in data) || isStr(data.adminNotes, 0, 600)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'parentId', 'parentName', 'studentName', 'tutorId', 'tutorUserId', 'tutorName',
          'subject', 'sessionCount', 'ratePerSessionEtb', 'totalAmountEtb',
          'commissionRate', 'commissionAmountEtb', 'tutorPayoutEtb',
          'locationNeighborhood', 'scheduleSummary', 'status', 'paymentStatus',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'parentId', 'parentName', 'studentId', 'studentName', 'tutorId', 'tutorUserId', 'tutorName',
          'subject', 'sessionCount', 'ratePerSessionEtb', 'totalAmountEtb',
          'commissionRate', 'commissionAmountEtb', 'tutorPayoutEtb',
          'locationNeighborhood', 'scheduleSummary', 'status', 'paymentStatus',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.parentId) &&
        isStr(data.parentName, 2, 120) &&
        (!('studentId' in data) || isStr(data.studentId, 0, 128)) &&
        isStr(data.studentName, 2, 120) &&
        isValidId(data.tutorId) &&
        isValidId(data.tutorUserId) &&
        isStr(data.tutorName, 2, 120) &&
        isStr(data.subject, 2, 100) &&
        data.sessionCount is number && data.sessionCount >= 1 && data.sessionCount <= 100 &&
        data.ratePerSessionEtb is number && data.ratePerSessionEtb >= 100 &&
        data.totalAmountEtb is number && data.totalAmountEtb >= 100 &&
        data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 0.5 &&
        data.commissionAmountEtb is number && data.commissionAmountEtb >= 0 &&
        data.tutorPayoutEtb is number && data.tutorPayoutEtb >= 0 &&
        isStr(data.locationNeighborhood, 2, 120) &&
        isStr(data.scheduleSummary, 2, 240) &&
        data.status in ['pending_tutor', 'pending_payment', 'confirmed', 'completed', 'cancelled'] &&
        data.paymentStatus in ['unpaid', 'submitted', 'verified', 'refunded'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPaymentRecord(data) {
      return data.keys().hasAll([
          'bookingId', 'parentId', 'tutorId', 'tutorUserId', 'method',
          'transactionRef', 'amountEtb', 'commissionEtb', 'tutorPayoutEtb',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'bookingId', 'parentId', 'tutorId', 'tutorUserId', 'method',
          'transactionRef', 'amountEtb', 'commissionEtb', 'tutorPayoutEtb',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.bookingId) &&
        isValidId(data.parentId) &&
        isValidId(data.tutorId) &&
        isValidId(data.tutorUserId) &&
        data.method in ['Telebirr', 'CBE Birr', 'Bank Transfer'] &&
        isStr(data.transactionRef, 3, 120) &&
        data.amountEtb is number && data.amountEtb >= 100 &&
        data.commissionEtb is number && data.commissionEtb >= 0 &&
        data.tutorPayoutEtb is number && data.tutorPayoutEtb >= 0 &&
        data.status in ['pending_verification', 'verified', 'rejected', 'refunded'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProgressReport(data) {
      return data.keys().hasAll([
          'bookingId', 'parentId', 'tutorId', 'tutorUserId', 'tutorName',
          'studentName', 'subject', 'sessionDate', 'attendanceStatus', 'summary',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'bookingId', 'parentId', 'tutorId', 'tutorUserId', 'tutorName',
          'studentName', 'subject', 'sessionDate', 'attendanceStatus', 'summary',
          'parentComment', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.bookingId) &&
        isValidId(data.parentId) &&
        isValidId(data.tutorId) &&
        isValidId(data.tutorUserId) &&
        isStr(data.tutorName, 2, 120) &&
        isStr(data.studentName, 2, 120) &&
        isStr(data.subject, 2, 100) &&
        isStr(data.sessionDate, 4, 40) &&
        data.attendanceStatus in ['present', 'absent', 'rescheduled'] &&
        isStr(data.summary, 4, 1000) &&
        (!('parentComment' in data) || isStr(data.parentComment, 0, 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['bookingId', 'tutorId', 'parentId', 'authorName', 'rating', 'comment', 'createdAt']) &&
        data.keys().hasOnly(['bookingId', 'tutorId', 'parentId', 'authorName', 'rating', 'comment', 'createdAt']) &&
        isValidId(data.bookingId) &&
        isValidId(data.tutorId) &&
        isValidId(data.parentId) &&
        isStr(data.authorName, 2, 100) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        isStr(data.comment, 4, 800) &&
        data.createdAt is timestamp;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['userId', 'userName', 'category', 'subject', 'message', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'userName', 'category', 'subject', 'message', 'status', 'adminResponse', 'createdAt', 'updatedAt']) &&
        isValidId(data.userId) &&
        isStr(data.userName, 2, 120) &&
        data.category in ['general', 'payment', 'reschedule', 'safeguarding', 'corporate'] &&
        isStr(data.subject, 3, 160) &&
        isStr(data.message, 5, 1500) &&
        data.status in ['open', 'in_review', 'resolved'] &&
        (!('adminResponse' in data) || isStr(data.adminResponse, 0, 1000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminLog(data) {
      return data.keys().hasAll(['adminUid', 'action', 'targetCollection', 'targetId', 'createdAt']) &&
        data.keys().hasOnly(['adminUid', 'action', 'targetCollection', 'targetId', 'details', 'createdAt']) &&
        isValidId(data.adminUid) &&
        isStr(data.action, 2, 120) &&
        isStr(data.targetCollection, 2, 80) &&
        isStr(data.targetId, 1, 128) &&
        (!('details' in data) || isStr(data.details, 0, 500)) &&
        data.createdAt is timestamp;
    }

    function isValidPlatformSetting(data) {
      return data.keys().hasAll(['key', 'updatedAt']) &&
        data.keys().hasOnly(['key', 'commissionRate', 'updatedAt']) &&
        isStr(data.key, 2, 80) &&
        (!('commissionRate' in data) || (data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 0.5)) &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // V1.1 CORPORATE TRAINING ENTITY BLUEPRINTS
    // =========================================================================

    function isValidOrganization(data) {
      return data.keys().hasAll([
          'ownerUid', 'name', 'orgType', 'industry', 'contactPerson',
          'officialEmail', 'phone', 'address', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'name', 'orgType', 'industry', 'contactPerson',
          'officialEmail', 'phone', 'address', 'logoUrl', 'billingInfo',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        isStr(data.name, 2, 160) &&
        data.orgType in ['Private Company', 'NGO', 'Government Institution', 'School / University', 'Development Organization', 'SME', 'Other'] &&
        isStr(data.industry, 2, 120) &&
        isStr(data.contactPerson, 2, 120) &&
        isStr(data.officialEmail, 3, 200) &&
        isStr(data.phone, 4, 40) &&
        isStr(data.address, 2, 240) &&
        (!('logoUrl' in data) || isStr(data.logoUrl, 0, 500)) &&
        (!('billingInfo' in data) || isStr(data.billingInfo, 0, 400)) &&
        data.status in ['pending', 'approved', 'suspended'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrganizationUser(data) {
      return data.keys().hasAll(['organizationId', 'userId', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['organizationId', 'userId', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.organizationId) &&
        isValidId(data.userId) &&
        data.role in ['owner', 'coordinator', 'viewer'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCorporateRequest(data) {
      return data.keys().hasAll([
          'organizationId', 'ownerUid', 'organizationName', 'category', 'topics',
          'objectives', 'participantCount', 'preferredDates', 'duration', 'location',
          'budgetMinEtb', 'budgetMaxEtb', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'organizationId', 'ownerUid', 'organizationName', 'category', 'topics',
          'objectives', 'participantCount', 'preferredDates', 'duration', 'location',
          'budgetMinEtb', 'budgetMaxEtb', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.organizationId) &&
        isValidId(data.ownerUid) &&
        isStr(data.organizationName, 2, 160) &&
        isStr(data.category, 2, 120) &&
        isBoundedStrList(data.topics, 1, 20) &&
        isStr(data.objectives, 5, 1500) &&
        data.participantCount is number && data.participantCount >= 1 && data.participantCount <= 5000 &&
        isStr(data.preferredDates, 2, 160) &&
        data.duration in ['One day', 'Two to three days', 'One week', 'Several weeks', 'Monthly / Customized'] &&
        isStr(data.location, 2, 200) &&
        data.budgetMinEtb is number && data.budgetMinEtb >= 500 &&
        data.budgetMaxEtb is number && data.budgetMaxEtb >= data.budgetMinEtb &&
        data.status in ['pending_review', 'trainers_sourced', 'proposal_sent', 'approved', 'in_progress', 'completed', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCorporateTrainer(data) {
      return data.keys().hasAll([
          'userId', 'fullName', 'headline', 'qualifications', 'experienceYears',
          'categories', 'topics', 'methodology', 'availability', 'preferredLocations',
          'proposedDailyRateEtb', 'isTutorAlso', 'status', 'isVerified', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'fullName', 'headline', 'bio', 'photoUrl', 'qualifications',
          'certifications', 'workExperience', 'experienceYears', 'categories', 'topics',
          'pastProjects', 'portfolioSamples', 'methodology', 'availability',
          'preferredLocations', 'languages', 'ratingAvg', 'reviewCount',
          'proposedDailyRateEtb', 'isTutorAlso', 'pendingQualificationUpdate',
          'status', 'isVerified', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        isStr(data.fullName, 2, 120) &&
        isStr(data.headline, 4, 160) &&
        (!('bio' in data) || isStr(data.bio, 0, 2000)) &&
        (!('photoUrl' in data) || isStr(data.photoUrl, 0, 500)) &&
        isStr(data.qualifications, 2, 400) &&
        (!('certifications' in data) || isBoundedStrList(data.certifications, 0, 20)) &&
        (!('workExperience' in data) || isStr(data.workExperience, 0, 1500)) &&
        data.experienceYears is number && data.experienceYears >= 0 && data.experienceYears <= 60 &&
        isBoundedStrList(data.categories, 1, 10) &&
        isBoundedStrList(data.topics, 1, 25) &&
        (!('pastProjects' in data) || isBoundedStrList(data.pastProjects, 0, 20)) &&
        (!('portfolioSamples' in data) || isBoundedStrList(data.portfolioSamples, 0, 20)) &&
        isStr(data.methodology, 10, 1500) &&
        isStr(data.availability, 2, 200) &&
        isBoundedStrList(data.preferredLocations, 1, 15) &&
        (!('languages' in data) || isBoundedStrList(data.languages, 0, 10)) &&
        (!('ratingAvg' in data) || (data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5)) &&
        (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0 && data.reviewCount <= 10000)) &&
        data.proposedDailyRateEtb is number && data.proposedDailyRateEtb >= 500 && data.proposedDailyRateEtb <= 250000 &&
        data.isTutorAlso is bool &&
        (!('pendingQualificationUpdate' in data) || isStr(data.pendingQualificationUpdate, 0, 600)) &&
        data.status in ['pending', 'approved', 'rejected', 'suspended'] &&
        data.isVerified is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTrainerPortfolioItem(data) {
      return data.keys().hasAll([
          'trainerId', 'trainerUserId', 'title', 'category', 'summary', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'trainerId', 'trainerUserId', 'title', 'category', 'summary',
          'outcomeMetrics', 'status', 'adminNotes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.trainerId) &&
        isValidId(data.trainerUserId) &&
        isStr(data.title, 2, 160) &&
        isStr(data.category, 2, 120) &&
        isStr(data.summary, 5, 1500) &&
        (!('outcomeMetrics' in data) || isStr(data.outcomeMetrics, 0, 400)) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('adminNotes' in data) || isStr(data.adminNotes, 0, 400)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedTrainer(data) {
      return data.keys().hasAll([
          'organizationId', 'organizationOwnerUid', 'trainerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'organizationId', 'organizationOwnerUid', 'trainerId', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.organizationId) &&
        isValidId(data.organizationOwnerUid) &&
        isValidId(data.trainerId) &&
        (!('notes' in data) || isStr(data.notes, 0, 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTrainerSelectionRequest(data) {
      return data.keys().hasAll([
          'organizationId', 'organizationOwnerUid', 'organizationName',
          'selectedTrainerId', 'selectedTrainerUserId', 'selectedTrainerName',
          'rankedTrainerIds', 'rankedTrainerNames', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'organizationId', 'organizationOwnerUid', 'organizationName', 'corporateRequestId',
          'selectedTrainerId', 'selectedTrainerUserId', 'selectedTrainerName',
          'rankedTrainerIds', 'rankedTrainerNames', 'notes', 'status',
          'suggestedTrainerId', 'suggestedTrainerName', 'adminNotes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.organizationId) &&
